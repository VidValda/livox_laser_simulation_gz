<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>livox_laser_simulation_gz</name>
  <version>0.1.0</version>
  <description>Livox non-repetitive lidar simulation for Gazebo Harmonic.
    Ported from https://github.com/Livox-SDK/livox_laser_simulation</description>
  <maintainer email="valdajosevid@gmail.com">VidValda</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-sim8</depend>
  <depend>gz-rendering8</depend>
  <depend>gz-transport13</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-sensors8</depend>
  <depend>gz-math7</depend>
  <depend>gz-common5</depend>
  <depend>gz-plugin2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
